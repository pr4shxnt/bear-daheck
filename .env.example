# Environment Configuration
# Copy this file to .env and fill in your values

# ─── Solana / Wallet ───────────────────────────────────────────────────────────
# Path to your Solana keypair JSON file (e.g. ~/.config/solana/id.json)
KEYPAIR_PATH=./keypair.json

# Solana RPC endpoint (mainnet-beta or devnet)
# Mainnet: https://api.mainnet-beta.solana.com
# Devnet:  https://api.devnet.solana.com
RPC_URL=https://api.devnet.solana.com

# ─── Strategy Parameters ────────────────────────────────────────────────────────
# Total USDC to deploy (e.g. 1000 for $1,000)
VAULT_SIZE_USDC=1000

# Minimum acceptable funding rate (annualised %).
# Bot will exit position if funding drops below this threshold.
MIN_FUNDING_RATE=0.01

# Rebalance interval in hours (default 6)
REBALANCE_INTERVAL_HOURS=6

# Volatility threshold (annualised %). Reduce size if vol exceeds this.
MAX_VOLATILITY_PCT=80

# ─── Drift ──────────────────────────────────────────────────────────────────────
# "mainnet" or "devnet"
DRIFT_ENV=devnet

# ─── Dashboard ──────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
